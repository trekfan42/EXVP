[node name="MarginContainer" type="MarginContainer" parent="GuiMargin/GUI/Main/PlaylistPanel/SettingsPopup/MarginContainer/VBoxContainer/MarginContainer2/HBoxContainer/Panel2/SettingsOptions/InfoDocumentation/VBoxContainer2/ScrollContainer/HelpTexts/HelpVideosText"]
