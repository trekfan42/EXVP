[node name="HelpTrimText2" type="Label" parent="GuiMargin/GUI/Main/PlaylistPanel/SettingsPopup/MarginContainer/VBoxContainer/MarginContainer2/HBoxContainer/Panel2/SettingsOptions/InfoDocumentation/VBoxContainer2/ScrollContainer/HelpTexts/HelpVideosText"]
custom_minimum_size = Vector2(220, 0)
layout_mode = 2
